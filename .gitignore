# Runtime data - don't commit your actual project database
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm

# Python
__pycache__/
**/__pycache__/
*.pyc

# OS cruft
.DS_Store
Thumbs.db

# Authelia (docker-compose.authelia.yml) - generated secrets and runtime
# state, never commit. Keep configuration.yml and users_database.yml.example
# tracked; everything else under authelia/config/ is local-only.
authelia/config/secrets/
authelia/config/users_database.yml
authelia/config/db.sqlite3
authelia/config/notification.txt
